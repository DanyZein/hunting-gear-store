# Nothing here is required today. The site reads its content from /content on disk.
# These are the variables you fill in when you add Payload + Neon + Blob later.
# See README.md -> "Adding a CMS later".

# Neon pooled connection string. Keep the -pooler host and sslmode=require.
# DATABASE_URI="postgres://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/ninebark?sslmode=require"

# Generate with: openssl rand -base64 32
# PAYLOAD_SECRET=""

# Vercel Blob read/write token, created in the Vercel dashboard under Storage.
# BLOB_READ_WRITE_TOKEN=""

# Absolute origin, used for absolute URLs in emails and the sitemap.
# NEXT_PUBLIC_SERVER_URL="http://localhost:3000"
